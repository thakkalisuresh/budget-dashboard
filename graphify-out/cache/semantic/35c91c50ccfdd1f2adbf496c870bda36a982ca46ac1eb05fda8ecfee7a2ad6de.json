{"nodes": [{"id": "backlog_offline_support", "label": "Offline Support Feature", "file_type": "rationale", "source_file": "BACKLOG.md", "source_location": "line 7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Offline support uses optimistic updates: expenses added offline are shown immediately in UI, queued to localStorage, and synced when connectivity returns. Auth bypass uses cached user profile to avoid re-prompting. Session expiry shows a small banner rather than auto-prompting, balancing UX and security."}, {"id": "backlog_offline_queue_js", "label": "src/offlineQueue.js", "file_type": "code", "source_file": "BACKLOG.md", "source_location": "line 23", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "backlog_use_auth_js", "label": "src/useAuth.js", "file_type": "code", "source_file": "BACKLOG.md", "source_location": "line 36", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "backlog_use_sheet_data_js", "label": "src/useSheetData.js", "file_type": "code", "source_file": "BACKLOG.md", "source_location": "line 42", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "backlog_sheets_api_js", "label": "src/sheetsApi.js", "file_type": "code", "source_file": "BACKLOG.md", "source_location": "line 47", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "backlog_app_jsx", "label": "src/App.jsx", "file_type": "code", "source_file": "BACKLOG.md", "source_location": "line 51", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "backlog_add_expense_dialog_jsx", "label": "src/AddExpenseDialog.jsx", "file_type": "code", "source_file": "BACKLOG.md", "source_location": "line 62", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "backlog_settings_panel_jsx", "label": "src/SettingsPanel.jsx", "file_type": "code", "source_file": "BACKLOG.md", "source_location": "line 155", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "backlog_vite_config_js", "label": "vite.config.js", "file_type": "code", "source_file": "BACKLOG.md", "source_location": "line 134", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "backlog_package_json", "label": "package.json", "file_type": "code", "source_file": "BACKLOG.md", "source_location": "line 160", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "backlog_version_build_number", "label": "Version / Build Number Feature", "file_type": "rationale", "source_file": "BACKLOG.md", "source_location": "line 122", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Version and build timestamp are baked into the JS bundle at build time via Vite defines (__APP_VERSION__, __BUILD_TIME__), ensuring they are always accurate for the deployed build with no runtime overhead or API calls."}, {"id": "backlog_local_storage_cache", "label": "localStorage Caching Strategy", "file_type": "rationale", "source_file": "BACKLOG.md", "source_location": "lines 106-109", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Auth token kept in sessionStorage (budget_auth) for security; offline auth cache goes to localStorage to survive browser close. Data cache key is budget_data_cache_${sheetId} to isolate per-spreadsheet. Queue items with retries > 3 are surfaced as failures rather than silently dropped."}, {"id": "backlog_google_sheets_integration", "label": "Google Sheets Integration", "file_type": "rationale", "source_file": "BACKLOG.md", "source_location": "line 47", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "backlog_google_oauth", "label": "Google OAuth Authentication", "file_type": "rationale", "source_file": "BACKLOG.md", "source_location": "lines 37-40", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "backlog_optimistic_updates", "label": "Optimistic UI Updates Pattern", "file_type": "rationale", "source_file": "BACKLOG.md", "source_location": "lines 16-18", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "When an expense is queued offline, it is shown immediately in the UI to preserve perceived responsiveness. The local data state is manually updated when { queued: true } is returned, without waiting for a server round-trip."}, {"id": "backlog_spending_trends", "label": "Spending Trends Feature", "file_type": "rationale", "source_file": "BACKLOG.md", "source_location": "line 182", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "backlog_budget_forecasting", "label": "Budget Forecasting Feature", "file_type": "rationale", "source_file": "BACKLOG.md", "source_location": "line 185", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "backlog_pdf_export", "label": "PDF Export Feature", "file_type": "rationale", "source_file": "BACKLOG.md", "source_location": "line 199", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "backlog_pdf_reconciliation", "label": "PDF Support for Reconciliation", "file_type": "rationale", "source_file": "BACKLOG.md", "source_location": "lines 228-232", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two approaches considered: Claude API (server-side PDF parsing, ~$0.04/statement, data leaves device) vs PDF.js (client-side, free, stays on device, messy for some bank formats). Decision parked pending user preference on privacy vs convenience trade-off."}, {"id": "backlog_multi_user", "label": "Multi-User Foundation", "file_type": "rationale", "source_file": "BACKLOG.md", "source_location": "line 213", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "backlog_onboarding_wizard", "label": "Onboarding Wizard", "file_type": "rationale", "source_file": "BACKLOG.md", "source_location": "lines 207-211", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two options considered: Option A (first-time setup wizard for deployers) vs Option B (UI walkthrough for family members). Option B recommended, shown once per user account tracked in UserSettings."}, {"id": "backlog_bank_reconciliation", "label": "Bank Reconciliation Feature", "file_type": "rationale", "source_file": "BACKLOG.md", "source_location": "line 241", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "backlog_smart_rules", "label": "Smart Rules Feature", "file_type": "rationale", "source_file": "BACKLOG.md", "source_location": "line 240", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "backlog_biometric_unlock", "label": "Biometric Unlock (WebAuthn)", "file_type": "rationale", "source_file": "BACKLOG.md", "source_location": "line 243", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "backlog_csv_export", "label": "CSV Export Feature", "file_type": "rationale", "source_file": "BACKLOG.md", "source_location": "line 246", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "backlog_uuid_transaction", "label": "UUID per Transaction", "file_type": "rationale", "source_file": "BACKLOG.md", "source_location": "line 238", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "backlog_offline_support", "target": "backlog_offline_queue_js", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "BACKLOG.md", "source_location": "line 23", "weight": 1.0}, {"source": "backlog_offline_support", "target": "backlog_use_auth_js", "relation": "references", "confidence": "EXTRA